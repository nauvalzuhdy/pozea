{
  "expo": {
    "name": "Pozea",
    "slug": "pozea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pozea",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pozea.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pozea memakai kamera untuk melihat posemu dan memandumu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1530",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pozea.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1530",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "extraProguardRules": "# Room builds databases by reflection on the generated _Impl class (used by WorkManager).\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }"
          }
        }
      ],
      "./plugins/withGradleMemory"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "zuhdys-team",
    "extra": {
      "eas": {
        "projectId": "01b54e55-d87f-4c7c-980c-1be0ad258c2f"
      }
    }
  }
}
