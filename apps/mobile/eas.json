{
  "cli": {
    "version": ">= 27.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -Pandroid.enableMinifyInReleaseBuilds=false"
      },
      "env": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "2"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug --max-workers=2"
      },
      "env": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "1",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=-Xmx3g"
      }
    }
  }
}
