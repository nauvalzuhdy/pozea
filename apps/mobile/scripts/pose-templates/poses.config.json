      "weights": { "rightElbow": 2, "rightShoulder": 2 },
      "override": { "leftElbow": { "angle": 70, "tolerance": 35 } },
      "hands": ["right"],
      "face": { "smileMin": 0.6, "pitch": 0, "yaw": 0 },
